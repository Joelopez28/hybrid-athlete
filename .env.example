# Copiá a .env (ignorado por git) y ajustá si hace falta.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_PORT=5432
POSTGREST_PORT=3000

# Solo desarrollo. Si cambiás esto, actualizá también db/init/001_roles.sql
# y la URI de compose.yaml. En producción usá secretos reales.
# AUTHENTICATOR_PASSWORD=authenticator-dev-password
PGRST_JWT_SECRET=dev-only-secret-change-me-please-32chars

# Frontend (Vite): opcional, el proxy por defecto apunta a localhost:8080.
# VITE_API_TARGET=http://localhost:8080
